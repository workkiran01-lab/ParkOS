{
  "name": "parkos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "typecheck:edge": "deno check --frozen supabase/functions/create-checkout-session/index.ts supabase/functions/create-permit-subscription/index.ts supabase/functions/receipt-download/index.ts supabase/functions/refund-payment/index.ts supabase/functions/stripe-webhook/index.ts",
    "test": "npm run check:sql && npm run test:unit",
    "test:unit": "node --test scripts/check-sql-special-forms.test.mjs scripts/local-database.test.mjs src/lib/booking-validation.test.ts src/lib/checkin.test.ts src/lib/csv.test.ts src/lib/facility-time.test.ts src/lib/permit-cancel.test.ts src/lib/ticket.test.ts supabase/functions/_shared/qr.test.ts supabase/functions/_shared/receipt-content.test.ts supabase/functions/_shared/stripe-payload.test.ts",
    "test:sql-guard": "npm run check:sql && node --test scripts/check-sql-special-forms.test.mjs",
    "test:db": "node scripts/run-sql-verifiers.mjs --tier database",
    "test:financial": "node scripts/run-sql-verifiers.mjs --tier financial",
    "test:concurrency": "node scripts/concurrency-test.mjs",
    "check:local-db": "node scripts/local-database.mjs",
    "db:seed:dev": "node scripts/run-sql-verifiers.mjs --seed",
    "test:acl": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/verify_no_anon_execute.sql",
    "verify:booth-payments": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260825010000_verify_booth_payments.sql",
    "verify:booth-revenue": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260826000000_verify_booth_revenue_reporting.sql",
    "verify:daily-manifest": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260826010000_verify_daily_manifest.sql",
    "verify:permit-payments": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260829000000_verify_permit_payments.sql",
    "verify:permit-event-ordering": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260901000000_verify_permit_event_ordering_guard.sql",
    "verify:permit-revenue": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260902000000_verify_permit_revenue_reporting.sql",
    "verify:invoice-paid": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260903000000_verify_invoice_paid.sql",
    "verify:dead-branch": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260904000000_verify_dead_branch_removed.sql",
    "verify:unresolved-payment": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260905000000_verify_unresolved_payment.sql",
    "verify:refund-ledgers": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260906000000_verify_refund_ledgers.sql",
    "verify:permit-cancellation": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/DEV_ONLY_verify_permit_cancellation.sql",
    "verify:permit-issuance": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/DEV_ONLY_verify_permit_issuance.sql",
    "verify:rls": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/DEV_ONLY_verify_rls_isolation.sql",
    "verify:privileged": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/DEV_ONLY_verify_privileged_functions.sql",
    "verify:reservation-corrections": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260907010000_verify_reservation_corrections.sql",
    "verify:facility-time": "node scripts/run-sql-verifiers.mjs --file supabase/dev-only/20260907020000_verify_facility_time.sql",
    "check:sql": "node scripts/check-sql-special-forms.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.33",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "deno": "2.9.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supabase": "^2.115.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0"
  }
}
